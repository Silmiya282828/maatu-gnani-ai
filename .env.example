# Copy this file to .env and fill in your own values. Never share or commit .env.
# Anything left blank uses the default in src/config.js.

# From https://app.gnani.ai/voice (the challenge credits live here)
GNANI_API_KEY=

# From https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=

# Default: gemini-2.5-flash
GEMINI_MODEL=

# The key a ride app sends to *our* API in the x-api-key header. Default: demo-key
CLIENT_API_KEY=

# Default: 4620
PORT=

# Safety net: max paid Gnani calls per server run (restart to reset). Default: 40
MAX_LIVE_CALLS=
