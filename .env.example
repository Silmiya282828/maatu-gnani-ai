# Copy this file to .env and fill in your keys. Never share or commit .env.

# From https://app.gnani.ai/voice (the challenge credits live here)
GNANI_API_KEY=

# From https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# The key a ride app would send to *our* API in the x-api-key header
CLIENT_API_KEY=demo-key

PORT=4620

# Safety net: max paid Gnani calls per server run (restart to reset)
MAX_LIVE_CALLS=40
