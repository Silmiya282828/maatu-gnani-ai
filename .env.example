# Copy this file to .env and fill in your own values. Never share or commit .env.
# Anything left blank uses the default in src/config.js.

# From https://app.gnani.ai/voice (the challenge credits live here)
GNANI_API_KEY=

# Translation: the first one with a key is used, in this order.
# Sarvam AI: https://dashboard.sarvam.ai (₹100 free credit on signup)
SARVAM_API_KEY=

# Bhashini (Government of India): sign up at https://bhashini.gov.in/ulca, then
# copy the user ID and API key from My Profile.
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Gemini: https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=

# Default: gemini-2.5-flash
GEMINI_MODEL=

# The key a ride app sends to *our* API in the x-api-key header. Default: demo-key
CLIENT_API_KEY=

# Default: 4620
PORT=

# Safety net: max paid Gnani calls per server run (restart to reset). Default: 40
MAX_LIVE_CALLS=
